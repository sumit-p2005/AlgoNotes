# AlgoNotes Environment Variables
# Copy this file to .env.local and populate with your Supabase project credentials.

# Supabase Public API (Exposed to browser, protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role Key (Server-only, NEVER expose to client)
# Optional: used only for administrative scripts / seed tasks if needed
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional App URL for OAuth & Email verification redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
